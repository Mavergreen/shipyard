#!/bin/sh
# platform: host-agnostic
set -eu
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
SHIPYARD_CHECK_DIR="$(cd "$(dirname "$self")" && pwd)"
export SHIPYARD_CHECK_DIR SHIPYARD_CHECK_REGISTRY
. "$SHIPYARD_CHECK_DIR/check-lib.sh"
. "$SHIPYARD_CHECK_DIR/lib/gh-admin.sh"
root="${SHIPYARD_CHECK_ROOT:-$(cd "$SHIPYARD_CHECK_DIR/.." && pwd)}"
target="$(pwd)"
reg="$SHIPYARD_CHECK_REGISTRY"

usage() {
  echo "usage: shipyard-check [--dist <dir>] [--repo-state] [--only <id>...] [--explain <id>] [--list]" >&2
  exit 2
}

dist=""; repo_state=0; only=""; explain=""; list=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dist) [ $# -ge 2 ] || usage; dist="$2"; shift 2 ;;
    --repo-state) repo_state=1; shift ;;
    --explain) [ $# -ge 2 ] || usage; explain="$2"; shift 2 ;;
    --list) list=1; shift ;;
    --only)
      shift
      [ $# -gt 0 ] || usage
      while [ $# -gt 0 ]; do
        case "$1" in -*) break ;; esac
        only="$only $1"; shift
      done ;;
    *) usage ;;
  esac
done

if [ -n "$explain" ]; then
  chk_registered "$explain" || { echo "shipyard-check: '$explain' is not a registered check id" >&2; exit 2; }
  cat "$root/explain/$explain.md"
  exit 0
fi
if [ "$list" -eq 1 ]; then
  cat "$reg"
  exit 0
fi

if [ -n "$dist" ] && [ -z "${SHIPYARD_CHECK_VERSION:-}" ]; then
  echo "shipyard-check: --dist needs SHIPYARD_CHECK_VERSION, the release's version (and SHIPYARD_CHECK_REPO, the repo whose INGREDIENTS.md declares deviations)" >&2
  exit 2
fi
if [ -n "$dist" ]; then
  _artifacts=0
  if [ -d "$dist" ]; then
    for _f in "$dist"/*.pkg "$dist"/*.tar.gz "$dist"/*.tgz "$dist"/*.tar.xz "$dist"/*.tar.bz2 "$dist"/*.xml; do
      [ ! -f "$_f" ] || { _artifacts=1; break; }
    done
  fi
  if [ "$_artifacts" -eq 0 ]; then
    echo "shipyard-check: --dist $dist holds no .pkg, release tarball or appcast (.xml), so there is nothing to check -- name the directory the release's artifacts were written to" >&2
    exit 2
  fi
fi

needs_admin=0
[ "$repo_state" -eq 0 ] || [ -n "$only" ] || needs_admin=1
for id in $only; do
  chk_registered "$id" || { echo "shipyard-check: '$id' is not a registered check id" >&2; exit 2; }
  [ "$(awk -F'\t' -v i="$id" '$1 == i { print $2 }' "$reg")" != key ] \
    || { echo "shipyard-check: '$id' is a deviation key, not a check: it excuses checks, and nothing runs under it" >&2; exit 2; }
  [ "$(awk -F'\t' -v i="$id" '$1 == i { print $2 }' "$reg")" != repo-state ] || needs_admin=1
done
[ "$needs_admin" -eq 0 ] || chk_gh_admin Mavergreen || exit 2

tab="$(printf '\t')"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/shipyard-check.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
id=; mode=; script=
while IFS="$tab" read -r id mode script _old _fate; do
  [ "$mode" != key ] || continue
  if [ -n "$only" ]; then
    case " $only " in *" $id "*) echo "$id $script" ;; esac
    continue
  fi
  case "$mode" in
    checkout) echo "$id $script" ;;
    dist) [ -z "$dist" ] || echo "$id $script" ;;
    repo-state) [ "$repo_state" -eq 0 ] || echo "$id $script" ;;
  esac
done < "$reg" > "$tmp/selected"
selected="$(cat "$tmp/selected")"
if [ -z "$selected" ]; then
  echo "shipyard-check: no checks selected" >&2
  exit 2
fi

SHIPYARD_CHECK_RUNLOG="$tmp/ran"; SHIPYARD_CHECK_FAILLOG="$tmp/failed"; SHIPYARD_CHECK_NOTRUNLOG="$tmp/notrun"
: > "$SHIPYARD_CHECK_RUNLOG"; : > "$SHIPYARD_CHECK_FAILLOG"; : > "$SHIPYARD_CHECK_NOTRUNLOG"
SHIPYARD_CHECK_SELECTED="$(printf '%s\n' "$selected" | cut -d' ' -f1 | tr '\n' ' ')"
export SHIPYARD_CHECK_RUNLOG SHIPYARD_CHECK_FAILLOG SHIPYARD_CHECK_NOTRUNLOG SHIPYARD_CHECK_SELECTED
[ -z "$dist" ] || SHIPYARD_CHECK_DIST="$dist"; export SHIPYARD_CHECK_DIST

reported() { cat "$SHIPYARD_CHECK_RUNLOG" "$SHIPYARD_CHECK_NOTRUNLOG" "$SHIPYARD_CHECK_FAILLOG" | grep -qxF -- "$1"; }
scripts="$(printf '%s\n' "$selected" | cut -d' ' -f2 | awk '!seen[$0]++')"
for script in $scripts; do
  ids="$(printf '%s\n' "$selected" | awk -v s="$script" '$2 == s { print $1 }')"
  before="$(wc -l < "$SHIPYARD_CHECK_FAILLOG")"
  rc=0
  (cd "$target" && sh "$root/$script" < /dev/null) || rc=$?
  after="$(wc -l < "$SHIPYARD_CHECK_FAILLOG")"
  if [ "$rc" -ne 0 ] && [ "$before" -eq "$after" ]; then
    blamed=""
    for id in $ids; do reported "$id" || { blamed="$id"; break; }; done
    chk_fail "${blamed:-$(printf '%s\n' "$ids" | head -n 1)}" "its script failed without naming a failed check" \
      "$script exited $rc and reported no failure among the selected checks; its own output is above" \
      "run it directly (sh $root/$script), which reports every check it owns, and fix what it names"
  fi
  for id in $ids; do
    reported "$id" && continue
    if [ "$rc" -eq 0 ]; then
      chk_fail "$id" "did not report" \
        "$script exited 0 without recording that this check ran, or why it did not, so a pass would vouch for nothing" \
        "report it from $script with chk_ran, or chk_notrun and the reason"
    else
      chk_notrun "$id" "$script exited $rc before reporting it"
    fi
  done
done

sort -u "$SHIPYARD_CHECK_NOTRUNLOG" > "$tmp/notrun.u"
sort -u "$SHIPYARD_CHECK_RUNLOG" "$SHIPYARD_CHECK_FAILLOG" | awk -v nf="$tmp/notrun.u" 'BEGIN { while ((getline l < nf) > 0) skip[l] = 1 } !skip[$0]' > "$tmp/ran.u"
n="$(wc -l < "$tmp/ran.u" | tr -d ' ')"
m="$(sort -u "$SHIPYARD_CHECK_FAILLOG" | wc -l | tr -d ' ')"
k="$(wc -l < "$tmp/notrun.u" | tr -d ' ')"
if [ "$k" -gt 0 ]; then echo "shipyard-check: $n checks, $m failed, $k not run"; else echo "shipyard-check: $n checks, $m failed"; fi
[ $((n + k + m)) -gt 0 ] || exit 2
[ "$m" -eq 0 ]
