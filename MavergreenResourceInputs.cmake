# MavergreenResourceInputs.cmake -- defines mavergreen_extract_resource_members(). No side effects at include.
#
# mavergreen_extract_resource_members(<out_var> ARCHIVE <abs zip> SHA256 <hex> MANIFEST <abs tsv>
#     MEMBER_PREFIX <archive dir/> VERSION_MEMBER <archive path> EXPECT_VERSION <version>
#     HOST_COMPILER <abs clang22> OUTPUT_DIR <abs dir>)
#   Stages the manifest's members of a pinned zip archive with mavergreen-resource-extract (built for
#   the host by mavergreen_build_host_tools under OUTPUT_DIR/host-tools): the archive's SHA-256 first,
#   then each selected member's type, size and SHA-256 while it streams, and VERSION_MEMBER's
#   CFBundleVersion and CFBundleShortVersionString. Nothing in the archive runs, and nothing it does
#   not select is written. <out_var> is set to OUTPUT_DIR/<key>/resources, keyed by every input. The
#   same inputs reuse it once every member there still has its manifest size and SHA-256, mode 0644,
#   and nothing else is there; anything else is refused and left as it is.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/MavergreenHostTools.cmake")
set(_MRI_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(_mri_fail msg)
  message(FATAL_ERROR "mavergreen_extract_resource_members: ${msg}")
endfunction()

function(_mri_manifest manifest out_dests out_sums out_sizes)
  file(STRINGS "${manifest}" lines ENCODING UTF-8)
  list(POP_FRONT lines header)
  set(dests)
  set(sums)
  set(sizes)
  foreach(line IN LISTS lines)
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if(NOT n EQUAL 5)
      _mri_fail("manifest line '${line}' does not have five tab-separated fields")
    endif()
    list(GET f 1 d)
    list(GET f 3 b)
    list(GET f 4 s)
    list(APPEND dests "${d}")
    list(APPEND sizes "${b}")
    list(APPEND sums "${s}")
  endforeach()
  set(${out_dests} "${dests}" PARENT_SCOPE)
  set(${out_sums} "${sums}" PARENT_SCOPE)
  set(${out_sizes} "${sizes}" PARENT_SCOPE)
endfunction()

function(_mri_entry_ok entry key dests sums sizes out_var)
  set(${out_var} FALSE PARENT_SCOPE)
  if(NOT EXISTS "${entry}/stamp.json" OR NOT IS_DIRECTORY "${entry}/resources")
    return()
  endif()
  file(READ "${entry}/stamp.json" stamp)
  string(JSON got ERROR_VARIABLE err GET "${stamp}" key)
  if(err OR NOT got STREQUAL key)
    return()
  endif()
  # platform: HFS+ lists a name decomposed (NFD) however it was created, so the staged names are
  #           matched by looking each manifest destination up and counting, not by comparing listings
  file(GLOB_RECURSE have LIST_DIRECTORIES false "${entry}/resources/*")
  list(LENGTH have nhave)
  list(LENGTH dests n)
  if(NOT nhave EQUAL n)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    list(GET dests ${i} d)
    list(GET sums ${i} s)
    list(GET sizes ${i} b)
    set(f "${entry}/resources/${d}")
    if(NOT EXISTS "${f}" OR IS_DIRECTORY "${f}" OR IS_SYMLINK "${f}")
      return()
    endif()
    file(SHA256 "${f}" h)
    file(SIZE "${f}" sz)
    execute_process(COMMAND stat -f %Lp "${f}" OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT h STREQUAL s OR NOT sz EQUAL b OR NOT mode STREQUAL "644")
      return()
    endif()
  endforeach()
  set(${out_var} TRUE PARENT_SCOPE)
endfunction()

function(mavergreen_extract_resource_members out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A ""
    "ARCHIVE;SHA256;MANIFEST;MEMBER_PREFIX;VERSION_MEMBER;EXPECT_VERSION;HOST_COMPILER;OUTPUT_DIR" "")
  if(A_UNPARSED_ARGUMENTS)
    _mri_fail("unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  foreach(k ARCHIVE MANIFEST HOST_COMPILER OUTPUT_DIR)
    if(NOT A_${k} OR NOT IS_ABSOLUTE "${A_${k}}")
      _mri_fail("${k} must be an absolute path, got '${A_${k}}'")
    endif()
  endforeach()
  foreach(k SHA256 VERSION_MEMBER EXPECT_VERSION)
    if(NOT A_${k})
      _mri_fail("${k} is required")
    endif()
  endforeach()
  if(NOT A_MEMBER_PREFIX OR NOT A_MEMBER_PREFIX MATCHES "/$")
    _mri_fail("MEMBER_PREFIX must name the archive directory the members are in, ending in /")
  endif()
  if(NOT EXISTS "${A_ARCHIVE}" OR NOT EXISTS "${A_MANIFEST}")
    _mri_fail("ARCHIVE '${A_ARCHIVE}' or MANIFEST '${A_MANIFEST}' does not exist")
  endif()
  string(REGEX REPLACE "/+$" "" out "${A_OUTPUT_DIR}")
  get_filename_component(out_parent "${out}" DIRECTORY)
  get_filename_component(out_name "${out}" NAME)
  if(NOT IS_DIRECTORY "${out_parent}")
    _mri_fail("OUTPUT_DIR's parent '${out_parent}' is not a directory")
  endif()
  file(REAL_PATH "${out_parent}" parent_real)
  set(out_real "${parent_real}/${out_name}")
  if(IS_SYMLINK "${out}")
    file(REAL_PATH "${out}" out_real)
  endif()
  file(MAKE_DIRECTORY "${out_real}")

  mavergreen_build_host_tools(bin OUTPUT_ROOT "${out_real}/host-tools" COMPILER "${A_HOST_COMPILER}")
  file(READ "${bin}/../stamp.json" tools_stamp)
  string(JSON tools_key GET "${tools_stamp}" key)
  file(SHA256 "${A_MANIFEST}" manifest_sha)
  file(SHA256 "${_MRI_DIR}/MavergreenResourceInputs.cmake" module_sha)
  string(JOIN "\n" identity "schema 1" "archive ${A_SHA256}" "manifest ${manifest_sha}"
    "prefix ${A_MEMBER_PREFIX}" "version-member ${A_VERSION_MEMBER}" "expect ${A_EXPECT_VERSION}"
    "module ${module_sha}" "tools ${tools_key}")
  string(SHA256 key "${identity}")
  string(SUBSTRING "${key}" 0 16 short)
  set(entry "${out_real}/${short}")
  _mri_manifest("${A_MANIFEST}" dests sums sizes)

  file(LOCK "${out_real}/.lock-${short}" GUARD FUNCTION RESULT_VARIABLE locked TIMEOUT 3600)
  if(NOT locked STREQUAL "0")
    _mri_fail("could not lock ${out_real}/.lock-${short}: ${locked}")
  endif()
  if(EXISTS "${entry}" OR IS_SYMLINK "${entry}")
    _mri_entry_ok("${entry}" "${key}" "${dests}" "${sums}" "${sizes}" ok)
    if(NOT ok)
      _mri_fail("${entry} does not hold exactly the manifest's members as this module staged them "
        "(changed, added, missing or unstamped); refusing to use or replace it. Remove it to extract again.")
    endif()
    set(${out_var} "${out}/${short}/resources" PARENT_SCOPE)
    return()
  endif()

  string(RANDOM LENGTH 8 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" tag)
  set(stage "${out_real}/.staging-${short}-${tag}")
  file(MAKE_DIRECTORY "${stage}")
  execute_process(COMMAND "${bin}/mavergreen-resource-extract" --archive "${A_ARCHIVE}" --sha256 "${A_SHA256}"
    --manifest "${A_MANIFEST}" --prefix "${A_MEMBER_PREFIX}" --version-member "${A_VERSION_MEMBER}"
    --expect-version "${A_EXPECT_VERSION}" --outdir "${stage}/resources"
    RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_VARIABLE outp)
  if(NOT rc EQUAL 0)
    file(REMOVE_RECURSE "${stage}")
    _mri_fail("mavergreen-resource-extract refused (${rc}): ${err}${outp}")
  endif()
  file(WRITE "${stage}/stamp.json" "{\"schema\":1,\"key\":\"${key}\"}\n")
  file(RENAME "${stage}" "${entry}" RESULT moved)
  if(NOT moved STREQUAL "0")
    _mri_fail("could not publish ${entry}: ${moved}")
  endif()
  set(${out_var} "${out}/${short}/resources" PARENT_SCOPE)
endfunction()
