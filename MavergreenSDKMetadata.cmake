# MavergreenSDKMetadata.cmake -- defines mavergreen_materialize_sdk_metadata(). No side effects at include.
#
# mavergreen_materialize_sdk_metadata(<out_var> SDK <abs dir> RECIPES <abs json> IDS <id>...
#                                    OUTPUT_DIR <abs dir that does not exist yet>)
#   Checks the selected recipes of a Recaulk sdk-metadata file (schema 1) against the SDK's own bytes,
#   writes each edited header under OUTPUT_DIR and a clang VFS overlay mapping the header's canonical
#   and alias paths onto that copy, and sets <out_var> to the overlay's path. The SDK is never written.
#   Every check runs before anything is written; OUTPUT_DIR appears whole or not at all.
include_guard(GLOBAL)
set(_MAVERGREEN_SDK_METADATA_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(_msm_fail msg)
  message(FATAL_ERROR "mavergreen_materialize_sdk_metadata: ${msg}")
endfunction()

function(_msm_only_keys obj where)
  string(JSON n LENGTH "${obj}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${obj}" ${i})
      if(NOT k IN_LIST ARGN)
        _msm_fail("${where} has unknown key '${k}'")
      endif()
    endforeach()
  endif()
  foreach(k IN LISTS ARGN)
    string(JSON t ERROR_VARIABLE err TYPE "${obj}" "${k}")
    if(err)
      _msm_fail("${where} lacks '${k}'")
    endif()
  endforeach()
endfunction()

function(_msm_string obj key where out)
  string(JSON t TYPE "${obj}" "${key}")
  if(NOT t STREQUAL "STRING")
    _msm_fail("${where}.${key} is ${t}, want STRING")
  endif()
  string(JSON v GET "${obj}" "${key}")
  if(v STREQUAL "")
    _msm_fail("${where}.${key} is empty")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

function(_msm_array obj key where out_len)
  string(JSON t TYPE "${obj}" "${key}")
  if(NOT t STREQUAL "ARRAY")
    _msm_fail("${where}.${key} is ${t}, want ARRAY")
  endif()
  string(JSON n LENGTH "${obj}" "${key}")
  set(${out_len} ${n} PARENT_SCOPE)
endfunction()

function(_msm_pinned_archive_sha out)
  file(STRINGS "${_MAVERGREEN_SDK_METADATA_DIR}/scripts/sdk-pins.sh" lines REGEX "^[ \t]*x86_64\\)[ \t]*echo")
  list(GET lines 0 line)
  string(REGEX MATCH "echo \"[^ ]+ ([0-9a-f]+) " m "${line}")
  string(LENGTH "${CMAKE_MATCH_1}" len)
  if(NOT len EQUAL 64)
    _msm_fail("cannot read the pinned x86_64 SDK archive SHA-256 from scripts/sdk-pins.sh")
  endif()
  set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(_msm_sdk_file sdk_real rel where out)
  if(rel MATCHES "^/" OR rel MATCHES "(^|/)\\.\\.?(/|$)" OR rel MATCHES "//" OR rel MATCHES "/$"
     OR rel MATCHES "[\n\r\t\"\\\\]")
    _msm_fail("${where} '${rel}' is not a plain path relative to the SDK")
  endif()
  if(NOT EXISTS "${sdk_real}/${rel}")
    _msm_fail("${where} '${rel}' does not exist in the SDK")
  endif()
  file(REAL_PATH "${sdk_real}/${rel}" real)
  string(FIND "${real}" "${sdk_real}/" at)
  if(NOT at EQUAL 0)
    _msm_fail("${where} '${rel}' resolves outside the SDK, to ${real}")
  endif()
  if(IS_DIRECTORY "${real}")
    _msm_fail("${where} '${rel}' is a directory, not a header")
  endif()
  set(${out} "${real}" PARENT_SCOPE)
endfunction()

function(_msm_json_string out s)
  string(REPLACE "\\" "\\\\" s "${s}")
  string(REPLACE "\"" "\\\"" s "${s}")
  set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

function(mavergreen_materialize_sdk_metadata out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A "_MSM_VALIDATE_ONLY" "SDK;RECIPES;OUTPUT_DIR" "IDS")
  if(A_UNPARSED_ARGUMENTS)
    _msm_fail("unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(A__MSM_VALIDATE_ONLY)
    set(A_OUTPUT_DIR "/validate-only")
  endif()
  foreach(k SDK RECIPES OUTPUT_DIR IDS)
    if(NOT A_${k})
      _msm_fail("${k} is required")
    endif()
  endforeach()
  foreach(k SDK RECIPES OUTPUT_DIR)
    if(NOT IS_ABSOLUTE "${A_${k}}")
      _msm_fail("${k} '${A_${k}}' is not an absolute path")
    endif()
  endforeach()

  string(REGEX REPLACE "/+$" "" sdk "${A_SDK}")
  if(NOT IS_DIRECTORY "${sdk}")
    _msm_fail("SDK '${sdk}' is not a directory")
  endif()
  file(REAL_PATH "${sdk}" sdk_real)

  string(REGEX REPLACE "/+$" "" out "${A_OUTPUT_DIR}")
  if(A__MSM_VALIDATE_ONLY)
  elseif(EXISTS "${out}" OR IS_SYMLINK "${out}")
    _msm_fail("OUTPUT_DIR '${out}' already exists; it must be fresh")
  endif()
  get_filename_component(out_parent "${out}" DIRECTORY)
  get_filename_component(out_name "${out}" NAME)
  if(NOT A__MSM_VALIDATE_ONLY)
    if(NOT IS_DIRECTORY "${out_parent}")
      _msm_fail("OUTPUT_DIR's parent '${out_parent}' is not a directory")
    endif()
    file(REAL_PATH "${out_parent}" parent_real)
    string(FIND "${parent_real}/" "${sdk_real}/" at)
    if(at EQUAL 0)
      _msm_fail("OUTPUT_DIR '${out}' resolves into the SDK, at ${parent_real}/${out_name}")
    endif()
  endif()

  if(NOT EXISTS "${A_RECIPES}")
    _msm_fail("RECIPES '${A_RECIPES}' does not exist")
  endif()
  file(READ "${A_RECIPES}" j)
  string(JSON t ERROR_VARIABLE err TYPE "${j}")
  if(err OR NOT t STREQUAL "OBJECT")
    _msm_fail("RECIPES '${A_RECIPES}' is not a JSON object")
  endif()
  _msm_only_keys("${j}" "the recipe file" schema sdk sdk_archive_sha256 recipes)
  string(JSON t TYPE "${j}" schema)
  string(JSON v GET "${j}" schema)
  if(NOT t STREQUAL "NUMBER" OR NOT v STREQUAL "1")
    _msm_fail("the recipe file's schema is '${v}'; this shipyard reads schema 1 only")
  endif()
  _msm_string("${j}" sdk "the recipe file" want_sdk)
  get_filename_component(sdk_name "${sdk_real}" NAME)
  if(NOT sdk_name STREQUAL "${want_sdk}.sdk")
    _msm_fail("the recipes are for ${want_sdk}.sdk, but SDK resolves to ${sdk_name}")
  endif()
  _msm_string("${j}" sdk_archive_sha256 "the recipe file" want_archive)
  _msm_pinned_archive_sha(pinned)
  if(NOT want_archive STREQUAL pinned)
    _msm_fail("the recipes were written against SDK archive ${want_archive}, not the pinned ${pinned}")
  endif()

  _msm_array("${j}" recipes "the recipe file" n)
  set(all_ids)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON r GET "${j}" recipes ${i})
      _msm_string("${r}" id "recipes[${i}]" id)
      if(id IN_LIST all_ids)
        _msm_fail("recipe id '${id}' appears more than once in ${A_RECIPES}")
      endif()
      list(APPEND all_ids "${id}")
      set(index_${id} ${i})
    endforeach()
  endif()

  set(seen_ids)
  set(seen_headers)
  set(seen_names)
  set(plan)
  foreach(id IN LISTS A_IDS)
    if(id IN_LIST seen_ids)
      _msm_fail("recipe id '${id}' is selected more than once")
    endif()
    list(APPEND seen_ids "${id}")
    if(NOT id IN_LIST all_ids)
      _msm_fail("no recipe '${id}' in ${A_RECIPES}")
    endif()
    string(JSON r GET "${j}" recipes ${index_${id}})
    set(w "recipe '${id}'")
    _msm_only_keys("${r}" "${w}" id header sha256 aliases replacements)
    _msm_string("${r}" header "${w}" header)
    _msm_string("${r}" sha256 "${w}" want_sha)
    _msm_sdk_file("${sdk_real}" "${header}" "${w} header" header_real)
    if(header_real IN_LIST seen_headers)
      _msm_fail("${w} edits ${header_real}, which another selected recipe already edits")
    endif()
    list(APPEND seen_headers "${header_real}")
    file(SHA256 "${header_real}" got_sha)
    if(NOT got_sha STREQUAL want_sha)
      _msm_fail("${w}: ${header} has SHA-256 ${got_sha}, the recipe wants ${want_sha}")
    endif()

    set(names "${header}")
    _msm_array("${r}" aliases "${w}" na)
    if(na GREATER 0)
      math(EXPR al "${na} - 1")
      foreach(a RANGE ${al})
        string(JSON t TYPE "${r}" aliases ${a})
        if(NOT t STREQUAL "STRING")
          _msm_fail("${w} aliases[${a}] is ${t}, want STRING")
        endif()
        string(JSON alias GET "${r}" aliases ${a})
        _msm_sdk_file("${sdk_real}" "${alias}" "${w} alias" alias_real)
        if(NOT alias_real STREQUAL header_real)
          _msm_fail("${w} alias '${alias}' resolves to ${alias_real}, not to the header ${header_real}")
        endif()
        list(APPEND names "${alias}")
      endforeach()
    endif()

    file(READ "${header_real}" text)
    _msm_array("${r}" replacements "${w}" nr)
    if(nr EQUAL 0)
      _msm_fail("${w} has no replacements")
    endif()
    math(EXPR rl "${nr} - 1")
    set(edits)
    foreach(k RANGE ${rl})
      string(JSON rep GET "${r}" replacements ${k})
      _msm_only_keys("${rep}" "${w} replacements[${k}]" old new)
      _msm_string("${rep}" old "${w} replacements[${k}]" old)
      _msm_string("${rep}" new "${w} replacements[${k}]" new_${k})
      string(FIND "${text}" "${old}" first)
      string(FIND "${text}" "${old}" final REVERSE)
      if(first EQUAL -1)
        _msm_fail("${w}: '${old}' does not occur in ${header}")
      endif()
      if(NOT first EQUAL final)
        _msm_fail("${w}: '${old}' occurs more than once in ${header}")
      endif()
      string(LENGTH "${old}" old_len)
      math(EXPR end_${k} "${first} + ${old_len}")
      set(start_${k} ${first})
      foreach(e IN LISTS edits)
        if(start_${k} LESS end_${e} AND start_${e} LESS end_${k})
          _msm_fail("${w}: replacements[${e}] and replacements[${k}] overlap in ${header}")
        endif()
      endforeach()
      list(APPEND edits ${k})
    endforeach()
    set(order)
    foreach(k IN LISTS edits)
      string(LENGTH "${start_${k}}" digits)
      math(EXPR zeros "12 - ${digits}")
      string(REPEAT "0" ${zeros} pad)
      list(APPEND order "${pad}${start_${k}}:${k}")
    endforeach()
    list(SORT order ORDER DESCENDING)
    foreach(o IN LISTS order)
      string(REGEX REPLACE ".*:" "" k "${o}")
      string(SUBSTRING "${text}" 0 ${start_${k}} head)
      string(SUBSTRING "${text}" ${end_${k}} -1 tail)
      set(text "${head}${new_${k}}${tail}")
    endforeach()

    list(LENGTH plan slot)
    set(text_${slot} "${text}")
    set(header_${slot} "${header}")
    set(names_${slot} "${names}")
    list(APPEND plan ${slot})
    foreach(name IN LISTS names)
      foreach(base "${sdk}" "${sdk_real}")
        if("${base}/${name}" IN_LIST seen_names)
          continue()
        endif()
        list(APPEND seen_names "${base}/${name}")
      endforeach()
    endforeach()
  endforeach()

  if(A__MSM_VALIDATE_ONLY)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" tag)
  set(stage "${parent_real}/.${out_name}.staging-${tag}")
  if(EXISTS "${stage}" OR IS_SYMLINK "${stage}")
    _msm_fail("staging directory ${stage} already exists")
  endif()
  set(vfs "{\"version\":0,\"case-sensitive\":\"true\",\"roots\":[]}")
  set(entry 0)
  foreach(slot IN LISTS plan)
    file(WRITE "${stage}/headers/${header_${slot}}" "${text_${slot}}")
    _msm_json_string(ext "${out}/headers/${header_${slot}}")
    set(mapped)
    foreach(name IN LISTS names_${slot})
      foreach(base "${sdk}" "${sdk_real}")
        if("${base}/${name}" IN_LIST mapped)
          continue()
        endif()
        list(APPEND mapped "${base}/${name}")
        _msm_json_string(jn "${base}/${name}")
        string(JSON vfs SET "${vfs}" roots ${entry} "{\"type\":\"file\",\"name\":${jn},\"external-contents\":${ext}}")
        math(EXPR entry "${entry} + 1")
      endforeach()
    endforeach()
  endforeach()
  file(WRITE "${stage}/overlay.json" "${vfs}\n")
  # platform: file(RENAME ... NO_REPLACE) needs renamex_np, which 10.9 lacks (it fails "Operation not
  #           permitted"); rename(2) itself refuses a non-empty target, and OUTPUT_DIR was checked absent
  if(EXISTS "${parent_real}/${out_name}" OR IS_SYMLINK "${parent_real}/${out_name}")
    file(REMOVE_RECURSE "${stage}")
    _msm_fail("OUTPUT_DIR '${out}' appeared while it was being generated")
  endif()
  file(RENAME "${stage}" "${parent_real}/${out_name}" RESULT moved)
  if(NOT moved STREQUAL "0")
    file(REMOVE_RECURSE "${stage}")
    _msm_fail("could not publish ${out}: ${moved}")
  endif()
  set(${out_var} "${out}/overlay.json" PARENT_SCOPE)
endfunction()

# mavergreen_target_sdk_metadata(TARGET <target> SDK <abs dir> RECIPES <abs json> IDS <id>...
#                               OUTPUT_DIR <abs generation root>)
#   Gives <target>'s Objective-C and Objective-C++ compiles, and nothing else, the overlay of the
#   selected recipes: -ivfsoverlay <overlay>, beside the unchanged sysroot. The overlay lives in a
#   generation under OUTPUT_DIR keyed by every input (SDK, recipe file, ids, compiler, this module).
#   A generation this module wrote, whose files still match its stamp, is reused; one without a stamp
#   or with a changed file is refused and left as it is.
function(_msm_target_fail msg)
  message(FATAL_ERROR "mavergreen_target_sdk_metadata: ${msg}")
endfunction()

set(_MSM_STAMP ".mavergreen-sdk-metadata-stamp.json")

function(_msm_generation_files gen out)
  file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${gen}" "${gen}/*")
  file(GLOB_RECURSE links LIST_DIRECTORIES true "${gen}/*")
  foreach(p IN LISTS links)
    if(IS_SYMLINK "${p}")
      _msm_target_fail("generation ${gen} holds a symbolic link, ${p}; refusing it")
    endif()
  endforeach()
  list(REMOVE_ITEM files "${_MSM_STAMP}")
  list(SORT files)
  set(${out} "${files}" PARENT_SCOPE)
endfunction()

function(_msm_verify_generation gen key)
  if(NOT EXISTS "${gen}/${_MSM_STAMP}")
    _msm_target_fail("${gen} exists but was not written by this module (no ${_MSM_STAMP}); "
      "refusing to use or replace it. Remove it to regenerate.")
  endif()
  file(READ "${gen}/${_MSM_STAMP}" stamp)
  string(JSON got_key ERROR_VARIABLE err GET "${stamp}" key)
  if(err OR NOT got_key STREQUAL key)
    _msm_target_fail("${gen}'s stamp is for other inputs; refusing to use or replace it. Remove it to regenerate.")
  endif()
  _msm_generation_files("${gen}" files)
  string(JSON n LENGTH "${stamp}" files)
  list(LENGTH files have)
  if(NOT have EQUAL n)
    _msm_target_fail("${gen} holds ${have} files, its stamp records ${n}: it was tampered with; "
      "refusing to use or replace it. Remove it to regenerate.")
  endif()
  foreach(rel IN LISTS files)
    string(JSON want ERROR_VARIABLE err GET "${stamp}" files "${rel}")
    file(SHA256 "${gen}/${rel}" got)
    if(err OR NOT got STREQUAL want)
      _msm_target_fail("${gen}/${rel} is not the file this module wrote: it was tampered with; "
        "refusing to use or replace it. Remove ${gen} to regenerate.")
    endif()
  endforeach()
endfunction()

function(_msm_generation out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "SDK;RECIPES;OUTPUT_DIR;IDENTITY" "IDS")
  file(REAL_PATH "${A_SDK}" sdk_real)
  string(REGEX REPLACE "/+$" "" groot "${A_OUTPUT_DIR}")
  file(MAKE_DIRECTORY "${groot}")
  file(REAL_PATH "${groot}" groot_real)
  string(FIND "${groot_real}/" "${sdk_real}/" at)
  if(at EQUAL 0)
    _msm_target_fail("OUTPUT_DIR '${groot}' resolves into the SDK")
  endif()

  file(SHA256 "${_MAVERGREEN_SDK_METADATA_DIR}/MavergreenSDKMetadata.cmake" generator)
  file(SHA256 "${A_RECIPES}" recipes_sha)
  string(JOIN "\n" identity "schema 1" "generator ${generator}" "recipes ${recipes_sha}"
    "ids ${A_IDS}" "sdk ${A_SDK}" "sdk-real ${sdk_real}"
    "compilers ${A_IDENTITY}")
  string(SHA256 key "${identity}")
  string(SUBSTRING "${key}" 0 16 short)
  set(gen "${groot}/${short}")

  if(EXISTS "${gen}" OR IS_SYMLINK "${gen}")
    if(IS_SYMLINK "${gen}" OR NOT IS_DIRECTORY "${gen}")
      _msm_target_fail("${gen} is not a directory this module wrote; refusing to use or replace it")
    endif()
    mavergreen_materialize_sdk_metadata(ignored _MSM_VALIDATE_ONLY SDK "${A_SDK}" RECIPES "${A_RECIPES}" IDS ${A_IDS})
    _msm_verify_generation("${gen}" "${key}")
  else()
    mavergreen_materialize_sdk_metadata(made SDK "${A_SDK}" RECIPES "${A_RECIPES}" IDS ${A_IDS}
      OUTPUT_DIR "${gen}")
    _msm_generation_files("${gen}" files)
    set(stamp "{\"schema\":1,\"files\":{}}")
    _msm_json_string(jkey "${key}")
    string(JSON stamp SET "${stamp}" key "${jkey}")
    foreach(rel IN LISTS files)
      file(SHA256 "${gen}/${rel}" h)
      _msm_json_string(jh "${h}")
      string(JSON stamp SET "${stamp}" files "${rel}" "${jh}")
    endforeach()
    file(WRITE "${gen}/${_MSM_STAMP}.tmp" "${stamp}\n")
    file(RENAME "${gen}/${_MSM_STAMP}.tmp" "${gen}/${_MSM_STAMP}")
  endif()
  set(${out_var} "${gen}/overlay.json" PARENT_SCOPE)
endfunction()

function(mavergreen_target_sdk_metadata)
  cmake_parse_arguments(PARSE_ARGV 0 A "" "TARGET;SDK;RECIPES;OUTPUT_DIR" "IDS")
  if(A_UNPARSED_ARGUMENTS)
    _msm_target_fail("unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  foreach(k TARGET SDK RECIPES OUTPUT_DIR IDS)
    if(NOT A_${k})
      _msm_target_fail("${k} is required")
    endif()
  endforeach()
  if(NOT TARGET "${A_TARGET}")
    _msm_target_fail("no target '${A_TARGET}'")
  endif()
  get_target_property(aliased "${A_TARGET}" ALIASED_TARGET)
  get_target_property(imported "${A_TARGET}" IMPORTED)
  get_target_property(type "${A_TARGET}" TYPE)
  if(aliased OR imported OR type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY")
    _msm_target_fail("'${A_TARGET}' is not a target this project compiles")
  endif()
  get_property(langs GLOBAL PROPERTY ENABLED_LANGUAGES)
  if(NOT "OBJC" IN_LIST langs AND NOT "OBJCXX" IN_LIST langs)
    _msm_target_fail("neither OBJC nor OBJCXX is enabled, so no compile could use the overlay")
  endif()
  foreach(k SDK RECIPES OUTPUT_DIR)
    if(NOT IS_ABSOLUTE "${A_${k}}")
      _msm_target_fail("${k} '${A_${k}}' is not an absolute path")
    endif()
  endforeach()
  if(NOT IS_DIRECTORY "${A_SDK}" OR NOT EXISTS "${A_RECIPES}")
    _msm_target_fail("SDK '${A_SDK}' or RECIPES '${A_RECIPES}' does not exist")
  endif()
  file(REAL_PATH "${A_SDK}" sdk_real)
  if(CMAKE_OSX_SYSROOT)
    file(REAL_PATH "${CMAKE_OSX_SYSROOT}" sysroot_real)
    if(NOT sysroot_real STREQUAL sdk_real)
      _msm_target_fail("SDK '${A_SDK}' is not this configure's sysroot '${CMAKE_OSX_SYSROOT}'; "
        "the overlay would never apply")
    endif()
  endif()

  _msm_generation(overlay SDK "${A_SDK}" RECIPES "${A_RECIPES}" IDS ${A_IDS} OUTPUT_DIR "${A_OUTPUT_DIR}"
    IDENTITY "objc ${CMAKE_OBJC_COMPILER} ${CMAKE_OBJC_COMPILER_VERSION} | objcxx ${CMAKE_OBJCXX_COMPILER} ${CMAKE_OBJCXX_COMPILER_VERSION}")
  target_compile_options("${A_TARGET}" PRIVATE
    "$<$<COMPILE_LANGUAGE:OBJC,OBJCXX>:SHELL:-ivfsoverlay \"${overlay}\">")
endfunction()
