# MavericksXcodeInputs.cmake -- defines mavericks_export_xcode_sources(). No side effects at include.
#
# mavericks_export_xcode_sources(<out_var> PROJECT <abs .xcodeproj> TARGETS <name>... PREFIXES <PREFIX>...
#                                HOST_COMPILER <abs clang22> OUTPUT_DIR <abs dir>)
#   Lists the selected targets' source files for a product's own CMake build, from the pinned
#   mulle-xcode-to-cmake exporter (sexport -r) checked against mavericks-xcode-inputs, an independent
#   reading of the same build phases. Both are built for the host by mavericks_build_host_tools under
#   OUTPUT_DIR/host-tools. PREFIXES name, in TARGETS' order, the variable prefix the exporter gives each
#   target (iTerm2Shared -> ITERM2_SHARED); with two or more targets a prefix it does not use is an
#   error, never a guess (it names a lone target's variables with no prefix, so those take PREFIXES).
#   The exporter's output is read as data, never run: every line must have the shape it writes, every
#   path must be a plain relative path to something inside the project's directory with no CMake syntax
#   in it, and each target's sources must be exactly the files (with their multiplicity) its sources
#   phase lists. Only then is <OUTPUT_DIR>/<key>/sources.cmake written, defining for each prefix
#   <P>_SOURCES (code only), <P>_MODELS (Core Data models, which are not compiled), and the exporter's
#   <P>_INCLUDE_DIRS, <P>_*_HEADERS and <P>_*RESOURCES, each a list of paths relative to the project's
#   directory, as bracket arguments. <out_var> is set to that file. The same inputs reuse it while it
#   matches its stamp; a changed or unstamped export is refused and left as it is.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/MavericksHostTools.cmake")
set(_MXI_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(_mxi_fail msg)
  message(FATAL_ERROR "mavericks_export_xcode_sources: ${msg}")
endfunction()

function(_mxi_check_path p root_real where)
  if(p STREQUAL "" OR p MATCHES "^/" OR p MATCHES "(^|/)\\.\\.(/|$)" OR p MATCHES "[][;$\"\\\\()\t\r]")
    _mxi_fail("${where}: '${p}' is not a plain relative path; refusing it before anything is generated")
  endif()
  if(NOT EXISTS "${root_real}/${p}")
    _mxi_fail("${where}: '${p}' does not exist in the project's directory")
  endif()
  file(REAL_PATH "${root_real}/${p}" real)
  string(FIND "${real}/" "${root_real}/" at)
  if(NOT at EQUAL 0)
    _mxi_fail("${where}: '${p}' leads outside the project's directory, to ${real}")
  endif()
endfunction()

function(_mxi_stamp_ok entry key out_var)
  set(${out_var} FALSE PARENT_SCOPE)
  if(NOT EXISTS "${entry}/stamp.json")
    return()
  endif()
  file(READ "${entry}/stamp.json" stamp)
  string(JSON got ERROR_VARIABLE err GET "${stamp}" key)
  if(err OR NOT got STREQUAL key)
    return()
  endif()
  file(GLOB files LIST_DIRECTORIES true RELATIVE "${entry}" "${entry}/*")
  list(REMOVE_ITEM files stamp.json)
  string(JSON n ERROR_VARIABLE err LENGTH "${stamp}" files)
  list(LENGTH files have)
  if(err OR NOT have EQUAL n)
    return()
  endif()
  foreach(rel IN LISTS files)
    string(JSON want ERROR_VARIABLE err GET "${stamp}" files "${rel}")
    if(err OR IS_DIRECTORY "${entry}/${rel}" OR IS_SYMLINK "${entry}/${rel}")
      return()
    endif()
    file(SHA256 "${entry}/${rel}" h)
    if(NOT h STREQUAL want)
      return()
    endif()
  endforeach()
  set(${out_var} TRUE PARENT_SCOPE)
endfunction()

function(_mxi_run what)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    _mxi_fail("${what} failed (${rc}): ${err}${out}")
  endif()
endfunction()

function(mavericks_export_xcode_sources out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "PROJECT;HOST_COMPILER;OUTPUT_DIR" "TARGETS;PREFIXES")
  if(A_UNPARSED_ARGUMENTS)
    _mxi_fail("unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  foreach(k PROJECT HOST_COMPILER OUTPUT_DIR)
    if(NOT A_${k} OR NOT IS_ABSOLUTE "${A_${k}}")
      _mxi_fail("${k} must be an absolute path, got '${A_${k}}'")
    endif()
  endforeach()
  string(REGEX REPLACE "/+$" "" project "${A_PROJECT}")
  if(NOT project MATCHES "\\.xcodeproj$" OR NOT EXISTS "${project}/project.pbxproj")
    _mxi_fail("PROJECT '${project}' is not an Xcode project")
  endif()
  list(LENGTH A_TARGETS nt)
  list(LENGTH A_PREFIXES np)
  if(nt EQUAL 0 OR NOT nt EQUAL np)
    _mxi_fail("TARGETS (${nt}) and PREFIXES (${np}) must be non-empty lists of the same length")
  endif()
  set(seen)
  foreach(p IN LISTS A_PREFIXES A_TARGETS)
    if(p IN_LIST seen)
      _mxi_fail("'${p}' is named twice in TARGETS or PREFIXES")
    endif()
    list(APPEND seen "${p}")
  endforeach()
  foreach(p IN LISTS A_PREFIXES)
    if(NOT p MATCHES "^[A-Z][A-Z0-9_]*$")
      _mxi_fail("prefix '${p}' is not an upper-case CMake identifier")
    endif()
  endforeach()
  foreach(t IN LISTS A_TARGETS)
    if(t STREQUAL "" OR t MATCHES "[\t\r\n\"\\\\$]")
      _mxi_fail("target name '${t}' is empty or holds a character this refuses")
    endif()
  endforeach()

  get_filename_component(src "${project}" DIRECTORY)
  file(REAL_PATH "${src}" src_real)
  string(REGEX REPLACE "/+$" "" out "${A_OUTPUT_DIR}")
  get_filename_component(out_parent "${out}" DIRECTORY)
  get_filename_component(out_name "${out}" NAME)
  if(NOT IS_DIRECTORY "${out_parent}")
    _mxi_fail("OUTPUT_DIR's parent '${out_parent}' is not a directory")
  endif()
  file(REAL_PATH "${out_parent}" parent_real)
  set(out_real "${parent_real}/${out_name}")
  if(IS_SYMLINK "${out}")
    file(REAL_PATH "${out}" out_real)
  endif()
  string(FIND "${out_real}/" "${src_real}/" at)
  if(at EQUAL 0)
    _mxi_fail("OUTPUT_DIR '${out}' resolves inside the project's directory; exports are written out of tree")
  endif()
  file(MAKE_DIRECTORY "${out_real}")

  mavericks_build_host_tools(bin OUTPUT_ROOT "${out_real}/host-tools" COMPILER "${A_HOST_COMPILER}")
  file(READ "${bin}/../stamp.json" tools_stamp)
  string(JSON tools_key GET "${tools_stamp}" key)
  file(SHA256 "${project}/project.pbxproj" pbx)
  file(SHA256 "${_MXI_DIR}/MavericksXcodeInputs.cmake" module_sha)
  string(JOIN "\n" identity "schema 1" "project ${pbx}" "targets ${A_TARGETS}" "prefixes ${A_PREFIXES}"
    "module ${module_sha}" "tools ${tools_key}")
  string(SHA256 key "${identity}")
  string(SUBSTRING "${key}" 0 16 short)
  set(entry "${out_real}/${short}")
  file(LOCK "${out_real}/.lock-${short}" GUARD FUNCTION RESULT_VARIABLE locked TIMEOUT 3600)
  if(NOT locked STREQUAL "0")
    _mxi_fail("could not lock ${out_real}/.lock-${short}: ${locked}")
  endif()
  if(EXISTS "${entry}" OR IS_SYMLINK "${entry}")
    _mxi_stamp_ok("${entry}" "${key}" ok)
    if(NOT ok)
      _mxi_fail("${entry} is not the export this module wrote for these inputs (changed, or unstamped); "
        "refusing to use or replace it. Remove it to export again.")
    endif()
    set(${out_var} "${out}/${short}/sources.cmake" PARENT_SCOPE)
    return()
  endif()

  string(RANDOM LENGTH 8 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" tag)
  set(stage "${out_real}/.staging-${short}-${tag}")
  file(MAKE_DIRECTORY "${stage}/out")
  set(target_args)
  foreach(t IN LISTS A_TARGETS)
    list(APPEND target_args --target "${t}")
  endforeach()
  _mxi_run("mavericks-xcode-inputs" "${bin}/mavericks-xcode-inputs" --project "${project}" ${target_args}
    --output "${stage}/out/audit.json")
  set(mulle_args)
  foreach(t IN LISTS A_TARGETS)
    list(APPEND mulle_args -t "${t}")
  endforeach()
  execute_process(COMMAND "${bin}/mulle-xcode-to-cmake" -r ${mulle_args} sexport "${project}"
    WORKING_DIRECTORY "${src_real}" RESULT_VARIABLE rc OUTPUT_FILE "${stage}/out/sexport.txt"
    ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    _mxi_fail("mulle-xcode-to-cmake sexport failed (${rc}): ${err}")
  endif()

  file(READ "${stage}/out/audit.json" audit)
  set(all_products)
  foreach(t IN LISTS A_TARGETS)
    string(JSON nr LENGTH "${audit}" targets "${t}" resources)
    if(nr GREATER 0)
      math(EXPR rl "${nr} - 1")
      foreach(r RANGE ${rl})
        string(JSON kind GET "${audit}" targets "${t}" resources ${r} kind)
        if(kind STREQUAL "product")
          string(JSON path GET "${audit}" targets "${t}" resources ${r} path)
          list(APPEND products_${t} "${path}")
          list(APPEND all_products "${path}")
        endif()
      endforeach()
    endif()
  endforeach()
  file(READ "${stage}/out/sexport.txt" text)
  if(text MATCHES "[][;\\\\\r\t]")
    _mxi_fail("the exporter's output holds a character CMake would interpret ([, ], ;, \\, a tab or CR); "
      "refusing it before anything is generated")
  endif()
  string(REPLACE "\n" ";" lines "${text}")
  set(var "")
  set(vars)
  set(n 0)
  foreach(line IN LISTS lines)
    math(EXPR n "${n} + 1")
    if(line STREQUAL "" OR line MATCHES "^##( [^$]*)?$")
      continue()
    elseif(var STREQUAL "" AND line MATCHES "^set\\( ([A-Z][A-Z0-9_]*)$")
      set(var "${CMAKE_MATCH_1}")
      if(var IN_LIST vars)
        _mxi_fail("the exporter defines ${var} twice (line ${n})")
      endif()
      list(APPEND vars "${var}")
      set(v_${var})
    elseif(NOT var STREQUAL "" AND line STREQUAL ")")
      set(var "")
    elseif(NOT var STREQUAL "" AND line MATCHES "^   \\$\\{([A-Z][A-Z0-9_]*)\\}$")
      if(NOT CMAKE_MATCH_1 IN_LIST vars OR CMAKE_MATCH_1 STREQUAL var)
        _mxi_fail("the exporter's ${var} refers to ${CMAKE_MATCH_1}, which it has not defined (line ${n})")
      endif()
      list(APPEND v_${var} ${v_${CMAKE_MATCH_1}})
    elseif(NOT var STREQUAL "" AND line MATCHES "^\"([^\"$]+)\"$|^([^ \"$#]+)$")
      set(entry_path "${CMAKE_MATCH_1}${CMAKE_MATCH_2}")
      if(NOT entry_path IN_LIST all_products)
        _mxi_check_path("${entry_path}" "${src_real}" "the exporter's ${var} (line ${n})")
      endif()
      list(APPEND v_${var} "${entry_path}")
    else()
      _mxi_fail("line ${n} of the exporter's output has a shape this does not read: '${line}'")
    endif()
  endforeach()
  if(NOT var STREQUAL "")
    _mxi_fail("the exporter's output ends inside ${var}")
  endif()

  if(nt EQUAL 1)
    # platform: mulle-xcode-to-cmake 0.9.1 names a lone target's variables with no prefix (SOURCES),
    #           even with -a, so a single target's variables take the caller's prefix
    set(renamed)
    foreach(v IN LISTS vars)
      if(NOT v MATCHES "^${A_PREFIXES}_")
        set(v_${A_PREFIXES}_${v} ${v_${v}})
        set(v "${A_PREFIXES}_${v}")
      endif()
      list(APPEND renamed "${v}")
    endforeach()
    set(vars ${renamed})
  endif()
  set(by_length)
  foreach(p IN LISTS A_PREFIXES)
    string(LENGTH "${p}" len)
    math(EXPR pad "1000 - ${len}")
    list(APPEND by_length "${pad}:${p}")
  endforeach()
  list(SORT by_length)
  foreach(v IN LISTS vars)
    set(owner "")
    foreach(e IN LISTS by_length)
      string(REGEX REPLACE "^[0-9]+:" "" p "${e}")
      if(v MATCHES "^${p}_(SOURCES|INCLUDE_DIRS|PUBLIC_HEADERS|PROJECT_HEADERS|PRIVATE_HEADERS|RESOURCES|[A-Z]+_RESOURCES)$")
        set(owner "${p}")
        break()
      endif()
    endforeach()
    if(owner STREQUAL "")
      _mxi_fail("the exporter wrote ${v}, which belongs to none of the PREFIXES ${A_PREFIXES}")
    endif()
  endforeach()

  set(generated "# Generated by MavericksXcodeInputs.cmake: source lists only, relative to the project's directory.\n")
  math(EXPR last "${nt} - 1")
  foreach(i RANGE ${last})
    list(GET A_TARGETS ${i} t)
    list(GET A_PREFIXES ${i} p)
    if(NOT "${p}_SOURCES" IN_LIST vars)
      _mxi_fail("the exporter wrote no ${p}_SOURCES for target ${t}; its prefix for ${t} is not ${p}")
    endif()
    set(want)
    set(models)
    string(JSON ns LENGTH "${audit}" targets "${t}" sources)
    if(ns GREATER 0)
      math(EXPR sl "${ns} - 1")
      foreach(s RANGE ${sl})
        string(JSON path GET "${audit}" targets "${t}" sources ${s} path)
        string(JSON kind GET "${audit}" targets "${t}" sources ${s} kind)
        list(APPEND want "${path}")
        if(kind STREQUAL "model")
          list(APPEND models "${path}")
        endif()
      endforeach()
    endif()
    set(got ${v_${p}_SOURCES})
    list(SORT want)
    list(SORT got)
    if(NOT want STREQUAL got)
      _mxi_fail("the exporter's ${p}_SOURCES is not ${t}'s sources phase: exporter has [${got}], "
        "the phase lists [${want}]")
    endif()
    set(code ${v_${p}_SOURCES})
    list(REMOVE_DUPLICATES models)
    foreach(m IN LISTS models)
      list(REMOVE_ITEM code "${m}")
    endforeach()
    set(model_entries ${v_${p}_SOURCES})
    list(FILTER model_entries EXCLUDE REGEX "^$")
    set(kept)
    foreach(e IN LISTS model_entries)
      if(e IN_LIST models)
        list(APPEND kept "${e}")
      endif()
    endforeach()
    set(v_${p}_SOURCES ${code})
    set(v_${p}_MODELS ${kept})
    set(names "${p}_SOURCES" "${p}_MODELS" "${p}_PRODUCT_RESOURCES")
    set(v_${p}_PRODUCT_RESOURCES)
    foreach(v IN LISTS vars)
      if(v MATCHES "^${p}_" AND NOT v STREQUAL "${p}_SOURCES")
        set(owned TRUE)
        foreach(other IN LISTS A_PREFIXES)
          string(LENGTH "${other}" ol)
          string(LENGTH "${p}" pl)
          if(ol GREATER pl AND v MATCHES "^${other}_")
            set(owned FALSE)
          endif()
        endforeach()
        if(owned)
          list(APPEND names "${v}")
        endif()
      endif()
    endforeach()
    list(SORT names)
    foreach(v IN LISTS names)
      if(v MATCHES "_RESOURCES$" AND NOT v STREQUAL "${p}_PRODUCT_RESOURCES")
        set(kept_files)
        foreach(e IN LISTS v_${v})
          if(e IN_LIST all_products)
            if(NOT e IN_LIST products_${t})
              _mxi_fail("the exporter's ${v} lists the built product ${e}, which ${t}'s resources phase does not")
            endif()
            if(NOT e IN_LIST v_${p}_PRODUCT_RESOURCES)
              list(APPEND v_${p}_PRODUCT_RESOURCES "${e}")
            endif()
          else()
            list(APPEND kept_files "${e}")
          endif()
        endforeach()
        set(v_${v} ${kept_files})
      endif()
    endforeach()
    foreach(v IN LISTS names)
      string(APPEND generated "\nset(${v}")
      foreach(e IN LISTS v_${v})
        string(APPEND generated "\n  [==[${e}]==]")
      endforeach()
      string(APPEND generated ")\n")
    endforeach()
  endforeach()
  file(WRITE "${stage}/out/sources.cmake" "${generated}")

  set(stamp "{\"schema\":1,\"files\":{}}")
  string(JSON stamp SET "${stamp}" key "\"${key}\"")
  foreach(f audit.json sexport.txt sources.cmake)
    file(SHA256 "${stage}/out/${f}" h)
    string(JSON stamp SET "${stamp}" files "${f}" "\"${h}\"")
  endforeach()
  file(WRITE "${stage}/out/stamp.json" "${stamp}\n")
  file(RENAME "${stage}/out" "${entry}" RESULT moved)
  if(NOT moved STREQUAL "0")
    _mxi_fail("could not publish ${entry}: ${moved}")
  endif()
  file(REMOVE_RECURSE "${stage}")
  set(${out_var} "${out}/${short}/sources.cmake" PARENT_SCOPE)
endfunction()
