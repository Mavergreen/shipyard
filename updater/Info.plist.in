<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>@MAVERICKS_XML_BUNDLE_ID@</string>
	<!-- CFBundleName is the host name Sparkle shows in its dialogs ("A new version of X is
	     available", "You're up to date"), so it's the PRODUCT name, not the helper's internal name.
	     CFBundleExecutable/Identifier/IconFile keep the internal executable name. -->
	<key>CFBundleName</key>
	<string>@MAVERICKS_XML_PRODUCT_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>@MAVERICKS_XML_EXECUTABLE@</string>
	<!-- Product icon for Sparkle's update dialog (else it shows a generic app icon). -->
	<key>CFBundleIconFile</key>
	<string>@MAVERICKS_XML_ICON_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Short string = the human "X.Y.Z-mavericks.N" (shown in Sparkle's dialogs). CFBundleVersion is
	     what Sparkle actually COMPARES, and its comparator can't order "-mavericks.N", so this is the
	     numeric-only form (X.Y.Z.N); see MavericksSparkle.cmake / gen_appcast.sh. -->
	<key>CFBundleShortVersionString</key>
	<string>@MAVERICKS_XML_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@MAVERICKS_XML_BUILD_VERSION@</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- LSUIElement: a launch shows no Dock icon and takes no focus. Only an interactive check and the
	     post-install alerts become a normal app (mav_foreground), before they show any UI. An interactive
	     launch goes through LaunchServices (open, NSWorkspace), never fork+exec: Sparkle's install needs
	     a LaunchServices-launched host to authorize and to see the host quit. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Fixed at the family's floor on purpose, not derived from the build's own deployment
	     target: a universal app is built once per arch and merged by lipo-merge-tree.sh, which
	     expects this Info.plist to come out byte-identical between the x86_64 and arm64 builds.
	     An arch-dependent value here would make the two builds' plists diverge and break that
	     merge (or force it onto lipo-merge-tree.sh's allow-differ option, which is not what this is for). -->
	<key>LSMinimumSystemVersion</key>
	<string>10.9</string>
	<key>SUFeedURL</key>
	<string>@MAVERICKS_XML_FEED_URL@</string>
	<!-- EdDSA public key (from generate_keys; matching private key is CI secret SPARKLE_PRIVATE_KEY).
	     Sparkle verifies every update against this. -->
	<key>SUPublicEDKey</key>
	<string>@MAVERICKS_XML_ED_PUBKEY@</string>
	<key>SUEnableAutomaticChecks</key>
	<@MAVERICKS_AUTO_CHECK@/>
</dict>
</plist>
