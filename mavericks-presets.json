{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "mavericks-x86_64",
      "hidden": true,
      "displayName": "x86_64: Mac OS X 10.9, any host",
      "binaryDir": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-x86_64",
      "toolchainFile": "${fileDir}/MavericksToolchain.cmake",
      "cacheVariables": {
        "MAVERICKS_PRESET_BUILD_ROOT": "$env{MAVERICKS_BUILD_ROOT}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.9",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-arm64",
      "hidden": true,
      "displayName": "arm64: macOS 11.0, any host",
      "binaryDir": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-arm64",
      "toolchainFile": "${fileDir}/MavericksToolchain.cmake",
      "cacheVariables": {
        "MAVERICKS_PRESET_BUILD_ROOT": "$env{MAVERICKS_BUILD_ROOT}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    }
  ]
}
