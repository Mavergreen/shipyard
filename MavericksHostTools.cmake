# MavericksHostTools.cmake -- defines mavericks_build_host_tools(). No side effects at include.
#
# mavericks_build_host_tools(<out_var> OUTPUT_ROOT <abs dir> COMPILER <abs clang22> [MULLE_SOURCE <abs dir>])
#   Builds shipyard's build-input tools for THIS Mac's hardware, in a configure of their own: arm64
#   against the pinned 11.3 SDK for macOS 11.0 on Apple Silicon (even when the caller runs translated),
#   x86_64 against the pinned 10.9 SDK for 10.9 otherwise. The compiler's default config is off, so no
#   product setting (target, Recaulk, libc++) reaches the host link. The exporter source is the pinned,
#   verified components/mulle-xcode-to-cmake; MULLE_SOURCE replaces it for tests only.
#   The tools land in OUTPUT_ROOT/<key>/bin, keyed by host arch, compiler, SDK pin, source and this
#   implementation, beside a stamp of each file's SHA-256. Same inputs reuse the entry once it matches
#   its stamp; a changed, unstamped or interrupted entry is set aside and rebuilt, never returned. One
#   writer at a time per key. <out_var> is set to the bin directory.
include_guard(GLOBAL)
set(_MHT_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(_MHT_TOOLS "mulle-xcode-to-cmake=mulle/mulle-xcode-to-cmake")

function(_mht_fail msg)
  message(FATAL_ERROR "mavericks_build_host_tools: ${msg}")
endfunction()

function(_mht_host_plan prefix)
  set(sysctl "${MAVERICKS_HOST_TOOLS_SYSCTL}")
  if(NOT sysctl)
    set(sysctl /usr/sbin/sysctl)
  endif()
  # platform: hw.optional.arm64 reports the hardware, so it is 1 on Apple Silicon even in a process
  #           Rosetta translates (whose uname -m and CMAKE_HOST_SYSTEM_PROCESSOR say x86_64); 10.9 has no
  #           such key and fails, which means Intel
  execute_process(COMMAND "${sysctl}" -n hw.optional.arm64 OUTPUT_VARIABLE arm RESULT_VARIABLE rc
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0 AND arm STREQUAL "1")
    set(arch arm64)
    set(min 11.0)
  else()
    set(arch x86_64)
    set(min 10.9)
  endif()
  set(${prefix}_ARCH "${arch}" PARENT_SCOPE)
  set(${prefix}_MIN "${min}" PARENT_SCOPE)
  set(${prefix}_TARGET "${arch}-apple-macos${min}" PARENT_SCOPE)
endfunction()

function(_mht_configure_args out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "ARCH;TARGET;MIN;SDK;COMPILER;SOURCE;BUILD_DIR;MAKE;MULLE" "")
  set(link "-fuse-ld=lld")
  if(A_ARCH STREQUAL "x86_64")
    # spec: clang22's own clang.cfg -- the same -U: compiler-rt's os_version_check member, which
    #       Mulle's -all_load pulls in, names a libSystem function 10.9 lacks and never calls there
    string(APPEND link " -Wl,-U,__availability_version_check")
  endif()
  set(args "-S${A_SOURCE}" "-B${A_BUILD_DIR}" "-GUnix Makefiles"
    "-DCMAKE_MAKE_PROGRAM=${A_MAKE}" -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    "-DCMAKE_C_COMPILER=${A_COMPILER}" "-DCMAKE_C_COMPILER_TARGET=${A_TARGET}"
    -DCMAKE_C_FLAGS=--no-default-config "-DCMAKE_EXE_LINKER_FLAGS=${link}"
    "-DCMAKE_OSX_ARCHITECTURES=${A_ARCH}" "-DCMAKE_OSX_SYSROOT=${A_SDK}"
    "-DCMAKE_OSX_DEPLOYMENT_TARGET=${A_MIN}")
  if(A_MULLE)
    list(APPEND args "-DMULLE_SOURCE=${A_MULLE}")
  endif()
  set(${out_var} "${args}" PARENT_SCOPE)
endfunction()

function(_mht_cache_key out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "ARCH;COMPILER_ID;SDK_PIN;SOURCE_ID;IMPL_ID" "")
  string(JOIN "\n" identity "schema 1" "arch ${A_ARCH}" "compiler ${A_COMPILER_ID}"
    "sdk ${A_SDK_PIN}" "source ${A_SOURCE_ID}" "implementation ${A_IMPL_ID}")
  string(SHA256 key "${identity}")
  set(${out_var} "${key}" PARENT_SCOPE)
endfunction()

function(_mht_tree_id dir out_var)
  file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${dir}" "${dir}/*")
  list(SORT files)
  set(lines)
  foreach(rel IN LISTS files)
    file(SHA256 "${dir}/${rel}" h)
    list(APPEND lines "${h} ${rel}")
  endforeach()
  string(JOIN "\n" text ${lines})
  string(SHA256 id "${text}")
  set(${out_var} "${id}" PARENT_SCOPE)
endfunction()

function(_mht_pin key out_var)
  file(STRINGS "${_MHT_DIR}/components/mulle-xcode-to-cmake/version" lines REGEX "^${key}=")
  list(LENGTH lines n)
  if(NOT n EQUAL 1)
    _mht_fail("components/mulle-xcode-to-cmake/version has ${n} ${key}= lines, want 1")
  endif()
  string(REGEX REPLACE "^${key}=" "" v "${lines}")
  set(${out_var} "${v}" PARENT_SCOPE)
endfunction()

function(_mht_sdk_pin arch out_var)
  file(STRINGS "${_MHT_DIR}/scripts/sdk-pins.sh" lines REGEX "^[ \t]*${arch}\\)[ \t]*echo \"https://")
  list(LENGTH lines n)
  if(NOT n EQUAL 1)
    _mht_fail("scripts/sdk-pins.sh has ${n} pins for ${arch}, want 1")
  endif()
  string(REGEX MATCH "echo \"([^\"]*)\"" m "${lines}")
  set(${out_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(_mht_entry_ok entry key out_var)
  set(${out_var} FALSE PARENT_SCOPE)
  if(IS_SYMLINK "${entry}" OR NOT IS_DIRECTORY "${entry}/bin" OR NOT EXISTS "${entry}/stamp.json")
    return()
  endif()
  file(READ "${entry}/stamp.json" stamp)
  string(JSON got ERROR_VARIABLE err GET "${stamp}" key)
  if(err OR NOT got STREQUAL key)
    return()
  endif()
  file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${entry}" "${entry}/*")
  list(REMOVE_ITEM files stamp.json)
  string(JSON n ERROR_VARIABLE err LENGTH "${stamp}" files)
  list(LENGTH files have)
  if(err OR NOT have EQUAL n)
    return()
  endif()
  foreach(rel IN LISTS files)
    string(JSON want ERROR_VARIABLE err GET "${stamp}" files "${rel}")
    file(SHA256 "${entry}/${rel}" h)
    if(err OR NOT h STREQUAL want OR IS_SYMLINK "${entry}/${rel}")
      return()
    endif()
  endforeach()
  set(${out_var} TRUE PARENT_SCOPE)
endfunction()

function(_mht_run what log)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_FILE "${log}" ERROR_FILE "${log}.err")
  if(NOT rc EQUAL 0)
    file(READ "${log}.err" err)
    file(READ "${log}" out)
    string(LENGTH "${out}" len)
    if(len GREATER 4000)
      math(EXPR from "${len} - 4000")
      string(SUBSTRING "${out}" ${from} -1 out)
    endif()
    _mht_fail("${what} failed (${rc}):\n${out}\n${err}")
  endif()
endfunction()

function(mavericks_build_host_tools out_var)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "OUTPUT_ROOT;COMPILER;MULLE_SOURCE" "")
  if(A_UNPARSED_ARGUMENTS)
    _mht_fail("unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT CMAKE_HOST_APPLE)
    _mht_fail("the host tools are Mach-O and build only on macOS")
  endif()
  foreach(k OUTPUT_ROOT COMPILER)
    if(NOT A_${k} OR NOT IS_ABSOLUTE "${A_${k}}")
      _mht_fail("${k} must be an absolute path, got '${A_${k}}'")
    endif()
  endforeach()
  if(NOT EXISTS "${A_COMPILER}" OR IS_DIRECTORY "${A_COMPILER}")
    _mht_fail("COMPILER '${A_COMPILER}' does not exist")
  endif()
  file(REAL_PATH "${A_COMPILER}" cc_real)
  get_filename_component(toolbin "${cc_real}" DIRECTORY)
  foreach(t llvm-lipo llvm-otool)
    if(NOT EXISTS "${toolbin}/${t}")
      _mht_fail("no ${t} beside ${cc_real}; COMPILER must be clang22")
    endif()
  endforeach()
  find_program(make NAMES make PATHS /usr/bin NO_DEFAULT_PATH NO_CACHE)
  if(NOT make)
    _mht_fail("no /usr/bin/make to build the host tools with")
  endif()

  string(REGEX REPLACE "/+$" "" root "${A_OUTPUT_ROOT}")
  get_filename_component(root_parent "${root}" DIRECTORY)
  get_filename_component(root_name "${root}" NAME)
  if(NOT IS_DIRECTORY "${root_parent}")
    _mht_fail("OUTPUT_ROOT's parent '${root_parent}' is not a directory")
  endif()
  file(REAL_PATH "${root_parent}" parent_real)
  set(root_real "${parent_real}/${root_name}")
  if(IS_SYMLINK "${root}")
    file(REAL_PATH "${root}" root_real)
  endif()
  set(fenced "${_MHT_DIR}")
  if(A_MULLE_SOURCE)
    if(NOT IS_ABSOLUTE "${A_MULLE_SOURCE}" OR NOT IS_DIRECTORY "${A_MULLE_SOURCE}")
      _mht_fail("MULLE_SOURCE '${A_MULLE_SOURCE}' is not an absolute directory")
    endif()
    file(REAL_PATH "${A_MULLE_SOURCE}" src_real)
    list(APPEND fenced "${src_real}")
  endif()
  foreach(f IN LISTS fenced)
    file(REAL_PATH "${f}" f_real)
    string(FIND "${root_real}/" "${f_real}/" at)
    if(at EQUAL 0)
      _mht_fail("OUTPUT_ROOT '${root}' resolves inside ${f_real}; host tools are built out of tree")
    endif()
  endforeach()

  _mht_host_plan(host)
  _mht_sdk_pin("${host_ARCH}" sdk_pin)
  execute_process(COMMAND "${cc_real}" --no-default-config --version OUTPUT_VARIABLE cc_version
    RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0)
    _mht_fail("'${cc_real} --version' failed")
  endif()
  file(SHA256 "${cc_real}" cc_sha)
  set(compiler_id "${cc_real} ${cc_sha} ${cc_version}")
  if(A_MULLE_SOURCE)
    _mht_tree_id("${src_real}" tree)
    set(source_id "test-supplied ${tree}")
  else()
    _mht_pin(REPO repo)
    _mht_pin(DIGEST digest)
    _mht_pin(TARBALL_SHA256 tarball)
    set(source_id "pinned ${repo} ${digest} ${tarball}")
  endif()
  file(SHA256 "${_MHT_DIR}/MavericksHostTools.cmake" module_sha)
  _mht_tree_id("${_MHT_DIR}/tools" tools_id)
  _mht_cache_key(key ARCH "${host_ARCH}" COMPILER_ID "${compiler_id}" SDK_PIN "${sdk_pin}"
    SOURCE_ID "${source_id}" IMPL_ID "${module_sha} ${tools_id}")
  string(SUBSTRING "${key}" 0 16 short)

  file(MAKE_DIRECTORY "${root_real}")
  set(entry "${root_real}/${short}")
  file(LOCK "${root_real}/.lock-${short}" GUARD FUNCTION RESULT_VARIABLE locked TIMEOUT 3600)
  if(NOT locked STREQUAL "0")
    _mht_fail("could not lock ${root_real}/.lock-${short}: ${locked}")
  endif()

  if(EXISTS "${entry}" OR IS_SYMLINK "${entry}")
    _mht_entry_ok("${entry}" "${key}" ok)
    if(ok)
      set(${out_var} "${root}/${short}/bin" PARENT_SCOPE)
      return()
    endif()
    string(RANDOM LENGTH 8 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" tag)
    message(STATUS "mavericks_build_host_tools: ${entry} does not match its stamp; set aside as .rejected-${short}-${tag} and rebuilt")
    file(RENAME "${entry}" "${root_real}/.rejected-${short}-${tag}")
  endif()

  string(RANDOM LENGTH 8 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" tag)
  set(stage "${root_real}/.staging-${short}-${tag}")
  file(MAKE_DIRECTORY "${stage}/out/bin")
  if(A_MULLE_SOURCE)
    set(mulle "${src_real}")
  else()
    set(mulle "${stage}/mulle-src")
    _mht_run("fetching the pinned exporter source" "${stage}/fetch.log"
      sh "${_MHT_DIR}/scripts/fetch_pinned_source.sh" "${repo}" "${digest}" "${tarball}" "${mulle}")
  endif()
  execute_process(COMMAND sh "${_MHT_DIR}/scripts/fetch_sdk.sh" --arch "${host_ARCH}"
    OUTPUT_VARIABLE sdk RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL 0 OR NOT IS_DIRECTORY "${sdk}")
    _mht_fail("could not fetch the pinned ${host_ARCH} SDK")
  endif()
  _mht_configure_args(args ARCH "${host_ARCH}" TARGET "${host_TARGET}" MIN "${host_MIN}" SDK "${sdk}"
    COMPILER "${cc_real}" SOURCE "${_MHT_DIR}/tools" BUILD_DIR "${stage}/build" MAKE "${make}" MULLE "${mulle}")
  _mht_run("configuring the host tools" "${stage}/configure.log" "${CMAKE_COMMAND}" ${args})
  _mht_run("building the host tools" "${stage}/build.log" "${CMAKE_COMMAND}" --build "${stage}/build")

  set(stamp "{\"schema\":1,\"files\":{}}")
  foreach(k key host_ARCH sdk_pin source_id)
    string(REPLACE "\\" "\\\\" v "${${k}}")
    string(REPLACE "\"" "\\\"" v "${v}")
    string(TOLOWER "${k}" jk)
    string(JSON stamp SET "${stamp}" "${jk}" "\"${v}\"")
  endforeach()
  string(JSON stamp SET "${stamp}" compiler "\"${cc_real}\"")
  foreach(spec IN LISTS _MHT_TOOLS)
    string(REGEX REPLACE "=.*" "" name "${spec}")
    string(REGEX REPLACE "^[^=]*=" "" built "${spec}")
    if(NOT EXISTS "${stage}/build/${built}")
      _mht_fail("the build produced no ${built}")
    endif()
    file(COPY "${stage}/build/${built}" DESTINATION "${stage}/out/bin"
      FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    set(tool "${stage}/out/bin/${name}")
    execute_process(COMMAND "${toolbin}/llvm-lipo" -archs "${tool}" OUTPUT_VARIABLE archs
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT archs STREQUAL host_ARCH)
      _mht_fail("${name} is '${archs}', not this host's ${host_ARCH}")
    endif()
    execute_process(COMMAND "${toolbin}/llvm-otool" -l "${tool}" OUTPUT_VARIABLE lc)
    if(NOT lc MATCHES "(version|minos) ${host_MIN}\n")
      _mht_fail("${name} does not record minimum macOS ${host_MIN}")
    endif()
    file(SHA256 "${tool}" h)
    string(JSON stamp SET "${stamp}" files "bin/${name}" "\"${h}\"")
  endforeach()
  file(WRITE "${stage}/out/stamp.json" "${stamp}\n")
  file(RENAME "${stage}/out" "${entry}" RESULT moved)
  if(NOT moved STREQUAL "0")
    _mht_fail("could not publish ${entry}: ${moved}")
  endif()
  file(REMOVE_RECURSE "${stage}")
  set(${out_var} "${root}/${short}/bin" PARENT_SCOPE)
endfunction()
