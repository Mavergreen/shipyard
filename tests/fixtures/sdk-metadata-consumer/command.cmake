# usage: cmake -DDB=<compile_commands.json> -DSOURCE=<file name> -P command.cmake
#        prints the compile command of the one entry whose file ends in /SOURCE
cmake_minimum_required(VERSION 3.19)
file(READ "${DB}" j)
string(JSON n LENGTH "${j}")
math(EXPR last "${n} - 1")
set(found)
foreach(i RANGE ${last})
  string(JSON f GET "${j}" ${i} file)
  if(f MATCHES "/${SOURCE}$")
    string(JSON c GET "${j}" ${i} command)
    list(APPEND found "${c}")
  endif()
endforeach()
list(LENGTH found count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "${count} compile commands for ${SOURCE}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${found}")
