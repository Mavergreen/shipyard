{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Mavergreen/shipyard"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "shipyard-cmake's CMake (cmake.pin). No hash to move: build-cmake.sh verifies the tarball against Kitware's own published SHA-256 file, and CI builds it, so a bump is gated on green like any other.",
      "managerFilePatterns": ["/^cmake\\.pin$/"],
      "matchStrings": ["CMAKE_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "cmake",
      "packageNameTemplate": "Kitware/CMake",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "The family toolchain that compiles shipyard-cmake's x86_64/10.9 half (mavericks-clang.pin). CI verifies the pkg against the release's SHA256SUMS; a bump rebuilds shipyard-cmake on green.",
      "managerFilePatterns": ["/^mavericks-clang\\.pin$/"],
      "matchStrings": ["MAVERICKS_CLANG_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "mavericks-clang",
      "packageNameTemplate": "Mavergreen/clang-22",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The ed25519-sign that signs every family release (scripts/ed25519.pin). sign_and_appcast.sh verifies the pkg against the release's SHA256SUMS.",
      "managerFilePatterns": ["/^scripts/ed25519\\.pin$/"],
      "matchStrings": ["ED25519_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "ed25519",
      "packageNameTemplate": "Mavergreen/ed25519",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d{8})-mavericks\\.(?<build>\\d+)$"
    }
  ]
}
